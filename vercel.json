{
  "version": 2,
  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/config/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/send/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/report/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/user/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}