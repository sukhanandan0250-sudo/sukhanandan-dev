{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/(auth|config|send|report|batch-status|scheduled-jobs|dashboard|parse-excel|provider-info|health|user|test-notification|batch-pause|batch-resume|batch-cancel)(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}