{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/auth/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/config/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/send/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/report/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/health",
      "dest": "api/index.js"
    },
    {
      "src": "/user/(.*)",
      "dest": "api/index.js"
    },

    {
      "handle": "filesystem"
    },

    {
      "src": "/(.*)",
      "dest": "/frontend/dist/index.html"
    }
  ]
}